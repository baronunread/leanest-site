  ogDescription="leanest diffs your PR, judges each e2e spec in parallel, and runs the real subset through your existing runner. Fails open, BYOK."
  twitterDescription="Diffs your PR, judges each e2e spec in parallel, and runs the real subset. Fails open, BYOK."
>
  <Nav />
  <Hero />
  <Stats />
  <Pipeline />
  <Cli />
