---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Fenced from '../components/Fenced.astro'
import CopyButton from '../components/CopyButton.astro'
import { ACTION_YAML, COMMANDS, OPTIONS, PROVIDERS } from '../data'

const sections = [
  { id: 'install', label: 'Install' },
  { id: 'quick-start', label: 'Quick start' },
  { id: 'cli', label: 'CLI' },
  { id: 'providers', label: 'Judge providers' },
  { id: 'ci', label: 'CI integration' },
]
---

<Layout
  title="Docs - leanest"
  description="leanest CLI reference: install, quick start, commands, flags, judge providers, and CI integration."
>
  <Nav />

  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[200px_1fr]">
      <aside class="hidden lg:block">
        <nav class="sticky top-24 flex flex-col gap-1 border-l border-[#1c211d] pl-4 text-sm">
          {
            sections.map((s) => (
              <a href={`#${s.id}`} class="py-1 text-[#9aa39d] transition-colors hover:text-[#f2f4f2]">
                {s.label}
              </a>
            ))
          }
        </nav>
      </aside>

      <main class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight">Docs</h1>
        <p class="mt-3 max-w-xl text-[#9aa39d]">
          Everything the CLI does, in one page. For the pitch, see the
          <a href="/#top" class="text-[#9aa39d] underline decoration-[#2c332e] underline-offset-2 hover:text-[#f2f4f2]">
            homepage
          </a>.
        </p>

        <section id="install" class="mt-12">
          <h2 class="text-xl font-semibold tracking-tight">Install</h2>
          <p class="mt-3 text-[#9aa39d]">
            Requires <a href="https://bun.sh" target="_blank" rel="noreferrer" class="underline decoration-[#2c332e] underline-offset-2 hover:text-[#f2f4f2]">Bun</a>: the CLI runs on it directly, no build step.
          </p>
          <div class="mt-4 overflow-hidden rounded-xl border border-[#232623] bg-[#121513]">
            <Fenced class="px-5 py-4">bun add -D leanest</Fenced>
          </div>
          <p class="mt-4 text-sm text-[#7c8a80]">
            Works with no setup: leanest defaults to classifier-dev, a free, no-auth judge.
          </p>
        </section>

        <section id="quick-start" class="mt-12">
          <h2 class="text-xl font-semibold tracking-tight">Quick start</h2>
          <div class="mt-4 overflow-hidden rounded-xl border border-[#232623] bg-[#121513]">
            <Fenced class="px-5 py-4"
              >{`npx leanest playwright                       # select + actually run the affected e2e tests
npx leanest playwright --base origin/main     # diff against a specific base
npx leanest select playwright                 # just show the selection, don't run anything
npx leanest inspect playwright                # rank every test by relevance, for debugging`}</Fenced
            >
          </div>
        </section>

        <section id="cli" class="mt-12">
          <h2 class="text-xl font-semibold tracking-tight">CLI</h2>
          <div class="mt-6 grid grid-cols-1 gap-10 md:grid-cols-2">
            <div>
              <div class="border-b border-[#1c211d] pb-2 font-mono text-xs tracking-wide text-[#7c8a80]">
                commands
              </div>
              <div class="mt-4 flex flex-col gap-5">
                {
                  COMMANDS.map(({ cmd, body }) => (
                    <div>
                      <code class="font-mono text-sm text-[#7cf0b6]">{cmd}</code>
                      <p class="mt-1 text-sm text-[#9aa39d]">{body}</p>
                    </div>
                  ))
                }
              </div>
            </div>
            <div>
              <div class="border-b border-[#1c211d] pb-2 font-mono text-xs tracking-wide text-[#7c8a80]">
                options
              </div>
              <div class="mt-4 flex flex-col gap-5">
                {
                  OPTIONS.map(({ flag, body }) => (
                    <div>
                      <code class="font-mono text-sm text-[#7cf0b6]">{flag}</code>
                      <p class="mt-1 text-sm text-[#9aa39d]">{body}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </section>

        <section id="providers" class="mt-12">
          <h2 class="text-xl font-semibold tracking-tight">Judge providers</h2>
          <p class="mt-3 max-w-2xl text-[#9aa39d]">
            leanest's selection judgment is pluggable. Pick one with
            <code class="font-mono text-[#c9d1cb]">LEANEST_PROVIDER</code>, or leave it on the free
            default.
          </p>
          <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
            {
              PROVIDERS.map((p) => (
                <div class="rounded-lg border border-[#232623] bg-[#121513] p-5">
                  <div class="flex items-center gap-2">
                    <code class="font-mono text-sm text-[#7cf0b6]">{p.name}</code>
                    {p.default && (
                      <span class="rounded-full border border-[#2c5842] bg-[#10241b] px-2 py-0.5 font-mono text-[10px] text-[#5fdba0]">
                        default
                      </span>
                    )}
                  </div>
                  <p class="mt-2 text-sm text-[#9aa39d]">{p.how}</p>
                  <p class="mt-3 font-mono text-xs text-[#7c8a80]">key: {p.key}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-4 overflow-hidden rounded-xl border border-[#232623] bg-[#121513]">
            <Fenced class="px-5 py-4">LEANEST_PROVIDER=jev npx leanest playwright</Fenced>
          </div>
        </section>

        <section id="ci" class="mt-12">
          <h2 class="text-xl font-semibold tracking-tight">CI integration</h2>
          <p class="mt-3 max-w-2xl text-[#9aa39d]">
            The GitHub Action installs Bun, installs leanest, and replaces your existing "run e2e
            tests" step. No secret required for the default provider, which also means
            forked-repo pull requests get selection too.
          </p>
          <div class="mt-4 overflow-hidden rounded-xl border border-[#232623] bg-[#121513]">
            <div class="flex items-center justify-between border-b border-[#1c211d] px-4 py-2.5">
              <span class="font-mono text-xs text-[#7c8a80]">.github/workflows/test.yml</span>
              <CopyButton text={ACTION_YAML} />
            </div>
            <Fenced class="px-5 py-5">{ACTION_YAML}</Fenced>
          </div>
          <p class="mt-4 text-[#9aa39d]">Any other CI: install globally and run the same command.</p>
          <div class="mt-4 overflow-hidden rounded-xl border border-[#232623] bg-[#121513]">
            <Fenced class="px-5 py-4"
              >{`bun add -g leanest
leanest playwright --base origin/main`}</Fenced
            >
          </div>
        </section>
      </main>
    </div>
  </div>

  <Footer />
</Layout>
