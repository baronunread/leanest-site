---
import Logo from './Logo.astro'
import Icon from './Icon.astro'
import { REPO } from '../data'
---

<header class="sticky top-0 z-20 border-b border-[#1c211d] bg-[#0b0d0c]/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/#top" class="flex items-center gap-2.5">
      <Logo size={26} />
      <span class="text-[17px] font-semibold tracking-tight">leanest</span>
    </a>
    <nav class="flex items-center gap-6">
      <a
        href="/docs"
        class="hidden text-sm text-[#9aa39d] transition-colors hover:text-[#f2f4f2] sm:block"
      >
        Docs
      </a>
      <a
        href="/#byok"
        class="hidden text-sm text-[#9aa39d] transition-colors hover:text-[#f2f4f2] sm:block"
      >
        BYOK
      </a>
      <a
        href={REPO}
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-1.5 text-sm text-[#9aa39d] transition-colors hover:text-[#f2f4f2] sm:flex"
      >
        <Icon name="github-logo" size={17} />
        GitHub
      </a>
      <a
        href="/#cta"
        class="rounded-md bg-[#5fdba0] px-3.5 py-2 text-sm font-semibold text-[#08150f] transition-colors hover:bg-[#7cf0b6]"
      >
        Add to your repo
      </a>
    </nav>
  </div>
</header>
