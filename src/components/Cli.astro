---
import { COMMANDS, OPTIONS } from '../data'
---

<section id="cli" class="border-b border-[#1c211d]">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="text-2xl font-semibold tracking-tight">The CLI</h2>
    <p class="mt-3 max-w-xl text-[#9aa39d]">
      One binary. It selects, then hands off to your real runner, so your reporter, retries and
      CI-required-check behavior stay exactly as they are.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-12 md:grid-cols-2">
      <div>
        <div class="border-b border-[#1c211d] pb-2 font-mono text-xs tracking-wide text-[#7c8a80]">
          commands
        </div>
        <div class="mt-4 flex flex-col gap-5">
          {
            COMMANDS.map(({ cmd, body }) => (
              <div>
                <code class="font-mono text-sm text-[#7cf0b6]">{cmd}</code>
                <p class="mt-1 text-sm text-[#9aa39d]">{body}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <div class="border-b border-[#1c211d] pb-2 font-mono text-xs tracking-wide text-[#7c8a80]">
          options
        </div>
        <div class="mt-4 flex flex-col gap-5">
          {
            OPTIONS.map(({ flag, body }) => (
              <div>
                <code class="font-mono text-sm text-[#7cf0b6]">{flag}</code>
                <p class="mt-1 text-sm text-[#9aa39d]">{body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
