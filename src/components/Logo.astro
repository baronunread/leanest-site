---
interface Props {
  size?: number
}

const { size = 28 } = Astro.props
---

<div
  class="flex shrink-0 items-center justify-center rounded-[7px] border border-[#2c5842] bg-[#1a3327]"
  style={{ width: `${size}px`, height: `${size}px` }}
>
  <svg
    width={size * 0.5}
    height={size * 0.5}
    viewBox="0 0 24 24"
    fill="none"
    stroke="#5fdba0"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
  </svg>
</div>
